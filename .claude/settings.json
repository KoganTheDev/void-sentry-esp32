{
  "permissions": {
    "deny": [
      "Read(**/secrets.h)",
      "Edit(**/secrets.h)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python \"$CLAUDE_PROJECT_DIR/.claude/hooks/guard_wifi_credentials.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
